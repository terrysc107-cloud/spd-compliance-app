# Copy this file to .env.local and fill in values.
# NEVER commit .env.local — it is in .gitignore.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Required for auth, database, and storage.
# NEXT_PUBLIC_ prefix is safe — anon key is restricted by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side ONLY. NEVER prefix with NEXT_PUBLIC_.
# Used for admin operations that bypass RLS (e.g., seed scripts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI / Report Generation ─────────────────────────────────────────────────
# Server-side ONLY. NEVER prefix with NEXT_PUBLIC_.
# Required for /api/generate-report — AI-powered compliance report generation.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Vercel AI Gateway URL (routes requests through Vercel proxy).
# Leave blank to call Anthropic directly.
AI_GATEWAY_URL=
